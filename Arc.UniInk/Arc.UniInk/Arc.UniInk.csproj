<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>Arc.UniInk</AssemblyName>
        <RootNamespace>Arc.UniInk</RootNamespace>
        <LangVersion>9</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        
        <!-- Assembly Information -->
        <AssemblyTitle>Arc.UniInk</AssemblyTitle>
        <Product>Arc.UniInk</Product>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Guid>F969106D-BD96-4E8F-A217-4B90D2975179</Guid>

        <!-- Generate XML documentation file -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Include XML documentation file in NuGet package -->
        <PublishDocumentationFile>true</PublishDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Arc.UniInk</PackageId>
        <Title>UniInk - AOT Expression Evaluator</Title>
        <Version>0.1.0</Version>
        <Authors>Arc-huangjingtong</Authors>
        <Description>UniInk - an AOT-friendly, zero-allocation C# expression and mini-script evaluator for Unity IL2CPP and .NET. No reflection and no boxing on the common path; supports variables, functions, lambdas and if/else.</Description>
        <PackageTags>unity;il2cpp;aot;expression-evaluator;script;zero-allocation;no-reflection</PackageTags>
        <PackageProjectUrl>https://github.com/Arc-huangjingtong/UniInk-AOT-ExpressionEvaluator</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Arc-huangjingtong/UniInk-AOT-ExpressionEvaluator.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <!-- PackageReadmeFile must use the path inside the nupkg, not the filesystem path -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Use repo root README.md as source, pack it to nupkg root as README.md -->
        <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>


</Project>