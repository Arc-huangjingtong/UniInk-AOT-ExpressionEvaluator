<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>9</LangVersion>
        <Nullable>disable</Nullable>
        <RootNamespace>Arc.UniInk.Sample.Sokoban.App</RootNamespace>
        <IsPackable>false</IsPackable>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <!-- dotnet run must launch the dll : the macOS apphost needs signing and is killed by Gatekeeper -->
        <UseAppHost>false</UseAppHost>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Arc.UniInk.Sample.Sokoban.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.23" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    </ItemGroup>
</Project>
